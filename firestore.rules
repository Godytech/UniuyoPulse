rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function profileMatchesClaims() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == request.auth.token.role
        && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.department == request.auth.token.department
        && (
          !('active' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.active == true
        );
    }

    function hasRole(roles) {
      return profileMatchesClaims() && request.auth.token.role in roles;
    }

    function isDevAdmin() {
      return hasRole(['dev_admin']);
    }

    function isLecturer() {
      return hasRole(['lecturer']);
    }

    function canManageDepartmentAcademicData() {
      return hasRole(['lecturer', 'course_rep_admin', 'assistant_course_rep', 'rep_admin']);
    }

    function hasDepartment(data) {
      return profileMatchesClaims()
        && request.auth.token.department is string
        && data.department is string
        && data.department == request.auth.token.department;
    }

    match /courses/{documentId} {
      allow read: if isDevAdmin() || (isSignedIn() && hasDepartment(resource.data));
      allow create, update: if canManageDepartmentAcademicData()
        && hasDepartment(request.resource.data);
      allow delete: if canManageDepartmentAcademicData()
        && hasDepartment(resource.data);
    }

    match /timetable/{documentId} {
      allow read: if isDevAdmin() || (isSignedIn() && hasDepartment(resource.data));
      allow create, update: if canManageDepartmentAcademicData()
        && hasDepartment(request.resource.data);
      allow delete: if canManageDepartmentAcademicData()
        && hasDepartment(resource.data);
    }

    match /sessions/{documentId} {
      allow read: if isDevAdmin() || (profileMatchesClaims() && hasDepartment(resource.data));
      allow create, update, delete: if false;
    }

    match /records/{documentId} {
      allow get: if isDevAdmin() || (profileMatchesClaims()
        && (
          resource.data.studentId == request.auth.uid
          || (canManageDepartmentAcademicData() && hasDepartment(resource.data))
        ));
      allow list: if isDevAdmin() || (profileMatchesClaims()
        && (
          resource.data.studentId == request.auth.uid
          || (canManageDepartmentAcademicData() && hasDepartment(resource.data))
        ));
      allow create, update, delete: if false;
    }

    match /notifications/{documentId} {
      allow read: if isDevAdmin() || (profileMatchesClaims() && hasDepartment(resource.data));
      allow create, update, delete: if false;
    }

    match /students/{uid} {
      allow get: if isSignedIn()
        && request.auth.token.email_verified == true
        && (
          request.auth.uid == uid
          || isDevAdmin()
          || (canManageDepartmentAcademicData() && hasDepartment(resource.data))
        );
      allow list: if isDevAdmin()
        || (canManageDepartmentAcademicData() && hasDepartment(resource.data));
      allow create, update, delete: if false;
    }

    match /userProfiles/{uid} {
      allow get: if isSignedIn()
        && request.auth.token.email_verified == true
        && (request.auth.uid == uid || isDevAdmin());
      allow list: if isDevAdmin();
      allow update: if profileMatchesClaims()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName',
          'semester',
          'academicSession'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'fullName',
          'semester',
          'academicSession'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.semester in ['First Semester', 'Second Semester']
        && request.resource.data.academicSession is string
        && request.resource.data.academicSession.matches('^[0-9]{4}/[0-9]{4}$');
      allow create, delete: if false;
    }

    match /faculties/{documentId} {
      allow read: if isDevAdmin();
      allow write: if false;
    }

    match /auditLog/{documentId} {
      allow read: if isDevAdmin();
      allow write: if false;
    }

    match /integrityAlerts/{documentId} {
      allow read: if isDevAdmin();
      allow write: if false;
    }

    match /sessionSecrets/{sessionId} {
      allow read, write: if false;
    }

    match /registrationInvitations/{invitationId} {
      allow read, write: if false;
    }

    match /appConfig/{documentId} {
      allow get: if isDevAdmin() && documentId == 'devSettings';
      allow list, write: if false;
    }

    match /securityAudit/{documentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
