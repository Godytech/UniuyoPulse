rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function profileMatchesClaims() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == request.auth.token.role
        && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.department == request.auth.token.department
        && (
          !('active' in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.active == true
        );
    }

    function hasRole(roles) {
      return profileMatchesClaims() && request.auth.token.role in roles;
    }

    function isLecturer() {
      return hasRole(['lecturer']);
    }

    function canManageDepartmentAcademicData() {
      return hasRole(['lecturer', 'course_rep_admin', 'assistant_course_rep', 'rep_admin']);
    }

    function hasDepartment(data) {
      return profileMatchesClaims()
        && request.auth.token.department is string
        && data.department is string
        && data.department == request.auth.token.department;
    }

    match /courses/{documentId} {
      allow read: if isSignedIn() && hasDepartment(resource.data);
      allow create, update: if canManageDepartmentAcademicData()
        && hasDepartment(request.resource.data);
      allow delete: if canManageDepartmentAcademicData()
        && hasDepartment(resource.data);
    }

    match /timetable/{documentId} {
      allow read: if isSignedIn() && hasDepartment(resource.data);
      allow create, update: if canManageDepartmentAcademicData()
        && hasDepartment(request.resource.data);
      allow delete: if canManageDepartmentAcademicData()
        && hasDepartment(resource.data);
    }

    match /sessions/{documentId} {
      allow read: if profileMatchesClaims() && hasDepartment(resource.data);
      allow create, update, delete: if false;
    }

    match /records/{documentId} {
      allow get: if profileMatchesClaims()
        && (
          resource.data.studentId == request.auth.uid
          || (canManageDepartmentAcademicData() && hasDepartment(resource.data))
        );
      allow list: if profileMatchesClaims()
        && (
          resource.data.studentId == request.auth.uid
          || (canManageDepartmentAcademicData() && hasDepartment(resource.data))
        );
      allow create, update, delete: if false;
    }

    match /notifications/{documentId} {
      allow read: if profileMatchesClaims() && hasDepartment(resource.data);
      allow create, update, delete: if false;
    }

    match /students/{uid} {
      allow get: if isSignedIn()
        && request.auth.token.email_verified == true
        && (
          request.auth.uid == uid
          || (canManageDepartmentAcademicData() && hasDepartment(resource.data))
        );
      allow list: if canManageDepartmentAcademicData()
        && hasDepartment(resource.data);
      allow create, update, delete: if false;
    }

    match /userProfiles/{uid} {
      allow get: if isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /sessionSecrets/{sessionId} {
      allow read, write: if false;
    }

    match /registrationInvitations/{invitationId} {
      allow read, write: if false;
    }

    match /appConfig/{documentId} {
      allow read, write: if false;
    }

    match /securityAudit/{documentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
